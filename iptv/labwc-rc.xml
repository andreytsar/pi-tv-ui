<?xml version="1.0"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <font place="ActiveWindow">
      <name>Nunito Sans</name>
      <size>14</size>
      <weight>Light</weight>
      <slant>Normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>Nunito Sans</name>
      <size>14</size>
      <weight>Light</weight>
      <slant>Normal</slant>
    </font>
    <name>PiXonyx</name>
  </theme>
  <keyboard>
    <repeatRate>25</repeatRate>
    <repeatDelay>764</repeatDelay>
  </keyboard>
  <windowRules>
    <windowRule identifier="smplayer" title="*SMPlayer*">
      <action name="Maximize" direction="both"/>
    </windowRule>
    <windowRule identifier="smplayer" title="Playlist">
      <action name="ResizeTo" width="440" height="640"/>
      <action name="MoveTo" x="1144" y="220"/>
    </windowRule>
  </windowRules>
</openbox_config>
